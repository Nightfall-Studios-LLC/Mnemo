{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Mnemo: Configure (Debug)",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/dev.ps1", "configure", "debug"],
      "problemMatcher": "$gcc"
    },
    {
      "label": "Mnemo: Build (Debug)",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/dev.ps1", "build", "debug"],
      "dependsOn": "Mnemo: Configure (Debug)",
      "dependsOrder": "sequence",
      "problemMatcher": "$gcc",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Mnemo: Test (Debug)",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/dev.ps1", "test", "debug"],
      "dependsOn": "Mnemo: Build (Debug)",
      "dependsOrder": "sequence",
      "problemMatcher": "$gcc",
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "Mnemo: Run (Debug)",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/dev.ps1", "run", "debug"],
      "dependsOn": "Mnemo: Build (Debug)",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Mnemo: Build and Test (Release)",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/dev.ps1", "all", "release"],
      "problemMatcher": "$gcc"
    }
  ]
}

